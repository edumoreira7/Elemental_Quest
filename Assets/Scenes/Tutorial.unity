  cartoes:
  - inicio: 0
    fim: 8
    tecla: A / D
    acao: Mover
  - inicio: 9
    fim: 20
    tecla: Shift esq.
    acao: Correr
  - inicio: 21
    fim: 27
    tecla: "Espa\xE7o"
    acao: Pular
  - inicio: 49
    fim: 56
    tecla: 1 2 3 4
    acao: Trocar elemento
  - inicio: 56
    fim: 74
    tecla: 1 + J
    acao: Criar degrau
  - inicio: 74
    fim: 96
    tecla: 4 + J
    acao: Congelar agua
  - inicio: 96
    fim: 106.5
    tecla: "2 + Espa\xE7o"
    acao: 'No alto: outro salto'
  - inicio: 106.5
    fim: 123
    tecla: Segure J
    acao: Planar ao cair
  - inicio: 123
    fim: 143
    tecla: 3 + J
    acao: Queimar raizes
