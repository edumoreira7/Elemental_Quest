--- !u!114 &580621661
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 580621660}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cf331f807a8707e4990ce71c75071d95, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::QuestTutorialArea
  jogador: {fileID: 1034870067}
  faixas:
  - inicio: -9
    fim: 8.5
    mensagem: 'A / D ou setas: andar'
  - inicio: 9
    fim: 20.5
    mensagem: 'Shift esq.: correr'
  - inicio: 21
    fim: 26.5
    mensagem: "Espa\xE7o: pular"
  - inicio: 27
    fim: 42
    mensagem: "Dire\xE7\xE3o + Espa\xE7o: subir"
  - inicio: 43
    fim: 49
    mensagem: Siga a trilha
  - inicio: 49
    fim: 56
    mensagem: '1-4: troque o elemento'
  - inicio: 56
    fim: 74
    mensagem: '1 + J: crie um degrau'
  - inicio: 74
    fim: 96
    mensagem: '4 + J: congele a agua'
  - inicio: 96
    fim: 106.5
    mensagem: 2 + Espaco no ar
  - inicio: 106.5
    fim: 123
    mensagem: Segure J ao cair
  - inicio: 123
    fim: 143
    mensagem: '3 + J: queime as raizes'
  - inicio: 143
    fim: 172
    mensagem: Observe e contra-ataque
  - inicio: 172
    fim: 193
    mensagem: Desvie e use o abrigo
  - inicio: 193
    fim: 232
    mensagem: Desafio final
  fimDaArea: 43
  fonte: {fileID: 0}
